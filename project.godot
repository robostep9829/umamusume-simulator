; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Umamusume Simulator"
run/main_scene="uid://dko8lei0ev8o7"
config/features=PackedStringArray("4.7", "C#", "Mobile")
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout="uid://pwi36xhvb2m1"

[autoload]

adreno_scaler="*res://scripts/autoload/graphics.gd"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="Umamusume Simulator"

[editor]

version_control/plugin_name="GitPlugin"
version_control/autoload_on_startup=true

[editor_plugins]

enabled=PackedStringArray("res://addons/rider-plugin/plugin.cfg")

